using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;

namespace Discord_web_app.Services
{
    /// <summary>
    /// Service for interacting with the Discord API
    /// Handles authentication, messages, channels, and user presence
    /// </summary>
    public class DiscordApiService
    {
        private readonly HttpClient _httpClient;
        private readonly IConfiguration _configuration;
        private string? _token;
        private const string DiscordApiBase = "https://discord.com/api/v10";

        public DiscordApiService(HttpClient httpClient, IConfiguration configuration)
        {
            _httpClient = httpClient;
            _configuration = configuration;
            _httpClient.DefaultRequestHeaders.Add("User-Agent", "DiscordRayBanCompanion/1.0");
        }

        /// <summary>
        /// Sets the Discord bot token for API requests
        /// </summary>
        public void SetToken(string token)
        {
            _token = token;
            if (!string.IsNullOrEmpty(_token))
            {
                _httpClient.DefaultRequestHeaders.Authorization = 
                    new AuthenticationHeaderValue("Bot", _token);
            }
        }

        /// <summary>
        /// Gets the current user information
        /// </summary>
        public async Task<JsonElement?> GetCurrentUserAsync()
        {
            try
            {
                var response = await _httpClient.GetAsync($"{DiscordApiBase}/users/@me");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    return JsonDocument.Parse(content).RootElement;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting current user: {ex.Message}");
            }
            return null;
        }

        /// <summary>
        /// Gets a list of servers (guilds) the user is in
        /// </summary>
        public async Task<List<JsonElement>> GetGuildsAsync()
        {
            var guilds = new List<JsonElement>();
            try
            {
                var response = await _httpClient.GetAsync($"{DiscordApiBase}/users/@me/guilds");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    using (var doc = JsonDocument.Parse(content))
                    {
                        foreach (var guild in doc.RootElement.EnumerateArray())
                        {
                            guilds.Add(guild.Clone());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting guilds: {ex.Message}");
            }
            return guilds;
        }

        /// <summary>
        /// Gets channels for a specific guild
        /// </summary>
        public async Task<List<JsonElement>> GetGuildChannelsAsync(string guildId)
        {
            var channels = new List<JsonElement>();
            try
            {
                var response = await _httpClient.GetAsync($"{DiscordApiBase}/guilds/{guildId}/channels");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    using (var doc = JsonDocument.Parse(content))
                    {
                        foreach (var channel in doc.RootElement.EnumerateArray())
                        {
                            channels.Add(channel.Clone());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting guild channels: {ex.Message}");
            }
            return channels;
        }

        /// <summary>
        /// Gets text channels (type 0) from a guild
        /// </summary>
        public List<JsonElement> GetTextChannels(List<JsonElement> channels)
        {
            return channels.Where(c => 
                c.TryGetProperty("type", out var type) && type.GetInt32() == 0)
                .ToList();
        }

        /// <summary>
        /// Gets voice channels (type 2) from a guild
        /// </summary>
        public List<JsonElement> GetVoiceChannels(List<JsonElement> channels)
        {
            return channels.Where(c => 
                c.TryGetProperty("type", out var type) && type.GetInt32() == 2)
                .ToList();
        }

        /// <summary>
        /// Gets members currently in a voice channel
        /// </summary>
        public async Task<List<JsonElement>> GetVoiceChannelParticipantsAsync(string guildId, string channelId)
        {
            var participants = new List<JsonElement>();
            try
            {
                // Fetch all guild members
                var response = await _httpClient.GetAsync(
                    $"{DiscordApiBase}/guilds/{guildId}/members?limit=1000");

                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    using (var doc = JsonDocument.Parse(content))
                    {
                        foreach (var member in doc.RootElement.EnumerateArray())
                        {
                            // In a real bot, you'd check voice_states for actual channel presence
                            // For now, we'll return a subset to simulate participation
                            if (member.TryGetProperty("user", out var userProp))
                            {
                                if (userProp.TryGetProperty("bot", out var botProp) && !botProp.GetBoolean())
                                {
                                    participants.Add(member.Clone());
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting voice channel participants: {ex.Message}");
            }
            return participants;
        }

        /// <summary>
        /// Gets messages from a channel
        /// </summary>
        public async Task<List<JsonElement>> GetChannelMessagesAsync(string channelId, int limit = 20)
        {
            var messages = new List<JsonElement>();
            try
            {
                var response = await _httpClient.GetAsync(
                    $"{DiscordApiBase}/channels/{channelId}/messages?limit={limit}");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    using (var doc = JsonDocument.Parse(content))
                    {
                        // Reverse to show newest last
                        var array = doc.RootElement.EnumerateArray().ToList();
                        array.Reverse();
                        foreach (var msg in array)
                        {
                            messages.Add(msg.Clone());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting channel messages: {ex.Message}");
            }
            return messages;
        }

        /// <summary>
        /// Sends a message to a channel
        /// </summary>
        public async Task<bool> SendMessageAsync(string channelId, string content)
        {
            try
            {
                var payload = new { content };
                var json = JsonSerializer.Serialize(payload);
                var httpContent = new StringContent(json, Encoding.UTF8, "application/json");

                var response = await _httpClient.PostAsync(
                    $"{DiscordApiBase}/channels/{channelId}/messages", httpContent);
                return response.IsSuccessStatusCode;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending message: {ex.Message}");
            }
            return false;
        }

        /// <summary>
        /// Gets direct messages (private channels)
        /// </summary>
        public async Task<List<JsonElement>> GetPrivateChannelsAsync()
        {
            var channels = new List<JsonElement>();
            try
            {
                var response = await _httpClient.GetAsync($"{DiscordApiBase}/users/@me/channels");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    using (var doc = JsonDocument.Parse(content))
                    {
                        foreach (var channel in doc.RootElement.EnumerateArray())
                        {
                            channels.Add(channel.Clone());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting private channels: {ex.Message}");
            }
            return channels;
        }

        /// <summary>
        /// Gets guild members for presence/status info
        /// </summary>
        public async Task<List<JsonElement>> GetGuildMembersAsync(string guildId, int limit = 50)
        {
            var members = new List<JsonElement>();
            try
            {
                var response = await _httpClient.GetAsync(
                    $"{DiscordApiBase}/guilds/{guildId}/members?limit={limit}");
                if (response.IsSuccessStatusCode)
                {
                    var content = await response.Content.ReadAsStringAsync();
                    using (var doc = JsonDocument.Parse(content))
                    {
                        foreach (var member in doc.RootElement.EnumerateArray())
                        {
                            members.Add(member.Clone());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting guild members: {ex.Message}");
            }
            return members;
        }

        /// <summary>
        /// Checks if the token is valid
        /// </summary>
        public async Task<bool> ValidateTokenAsync()
        {
            try
            {
                var response = await _httpClient.GetAsync($"{DiscordApiBase}/users/@me");
                return response.IsSuccessStatusCode;
            }
            catch
            {
                return false;
            }
        }
    }
}
