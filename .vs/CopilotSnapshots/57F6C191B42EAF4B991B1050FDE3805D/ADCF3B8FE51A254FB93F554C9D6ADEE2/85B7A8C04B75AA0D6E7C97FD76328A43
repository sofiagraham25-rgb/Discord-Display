@using System.Text.Json
@using Discord_web_app.Services

<div class="voice-channels-container">
    <div class="voice-list">
        <h3>Voice Channels</h3>
        @if (Channels == null || Channels.Count == 0)
        {
            <p class="empty-state">No voice channels available</p>
        }
        else
        {
            <div class="channel-list">
                @foreach (var channel in Channels)
                {
                    var channelId = channel.GetProperty("id").GetString();
                    var channelName = channel.GetProperty("name").GetString();
                    var isSelected = channelId == CurrentVoiceChannelId;

                    <div class="channel-item @(isSelected ? "active" : "")" 
                         @onclick="@(() => OnChannelSelect.InvokeAsync(channel))">
                        <div class="channel-info">
                            <span class="channel-name">🎙️ @channelName</span>
                            @if (isSelected)
                            {
                                <span class="connected-badge">● Connected</span>
                            }
                        </div>
                        <button class="join-btn" 
                                @onclick:stopPropagation
                                @onclick="@(() => OnVoiceChannelJoin.InvokeAsync((channelId, channelName, !isSelected)))">
                            @(isSelected ? "Leave" : "Join")
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(CurrentVoiceChannelName))
    {
        <div class="current-channel-info">
            <h4>Currently Connected</h4>
            <div class="info-card">
                <p><strong>Channel:</strong> @CurrentVoiceChannelName</p>

                <!-- Microphone Toggle -->
                <div class="microphone-section">
                    <button class="mic-button @(IsMicOn ? "mic-on" : "mic-off")" 
                            @onclick="ToggleMicrophone">
                        @(IsMicOn ? "🎤 Microphone ON" : "🔇 Microphone OFF")
                    </button>
                    @if (IsMicOn)
                    {
                        <p class="mic-status">Microphone is active - you can speak</p>
                    }
                </div>

                @if (VoiceChannelParticipants != null && VoiceChannelParticipants.Count > 0)
                {
                    <p><strong>Participants:</strong> @VoiceChannelParticipants.Count</p>
                    <div class="participants-list">
                        @foreach (var participant in VoiceChannelParticipants)
                        {
                            var username = participant.GetProperty("username").GetString();
                            <div class="participant">👤 @username</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public List<JsonElement>? Channels { get; set; }

    [Parameter]
    public JsonElement? SelectedChannel { get; set; }

    [Parameter]
    public string? CurrentVoiceChannelId { get; set; }

    [Parameter]
    public string? CurrentVoiceChannelName { get; set; }

    [Parameter]
    public List<JsonElement>? VoiceChannelParticipants { get; set; }

    [Parameter]
    public EventCallback<JsonElement> OnChannelSelect { get; set; }

    [Parameter]
    public EventCallback<(string ChannelId, string ChannelName, bool IsJoining)> OnVoiceChannelJoin { get; set; }

    private bool IsMicOn = false;

    private void ToggleMicrophone()
    {
        IsMicOn = !IsMicOn;
        if (IsMicOn)
        {
            // Microphone is now ON
        }
        else
        {
            // Microphone is now OFF
        }
    }
}

