@using System.Text.Json

<div style="display: flex; flex-direction: column; gap: 8px; height: 100%; overflow: hidden;">
    <!-- Guild selector -->
    <!-- Guild selector -->
    <div style="display: flex; gap: 4px; overflow-x: auto; flex-shrink: 0; padding-bottom: 4px;">
        @foreach (var guild in Guilds)
        {
            var guildId = guild.GetProperty("id").GetString();
            var guildName = guild.GetProperty("name").GetString();
            var isSelected = SelectedGuild.HasValue && 
                            SelectedGuild.Value.GetProperty("id").GetString() == guildId;

            <button class="channel-item @(isSelected ? "active" : "")" 
                    @onclick="@(() => OnGuildSelect.InvokeAsync(guild))"
                    style="white-space: nowrap; flex-shrink: 0;">
                @guildName
            </button>
        }
    </div>

    <!-- Channels and messages layout -->
    <div style="display: flex; gap: 8px; flex: 1; overflow: hidden;">
        <!-- Channels sidebar -->
        <div style="width: 40%; display: flex; flex-direction: column; overflow: hidden; border-right: 1px solid var(--glasses-bg-secondary);">
            <div style="font-size: var(--font-size-small); font-weight: 600; padding: 4px 8px; color: var(--glasses-text-secondary);">
                Channels
            </div>
            <ul class="channel-list" style="flex: 1; overflow-y: auto; padding: 0 4px;">
                @if (SelectedGuild.HasValue)
                {
                    var guildId = SelectedGuild.Value.GetProperty("id").GetString();
                    @* Note: You'd need to load channels for the selected guild *@
                    <li class="channel-item active" @onclick="@(() => {})">
                        # general
                    </li>
                }
            </ul>
        </div>

        <!-- Messages area -->
        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
            <!-- Selected channel header -->
            <div style="padding: 4px 8px; border-bottom: 1px solid var(--glasses-bg-secondary); font-size: var(--font-size-small); font-weight: 600;">
                @if (SelectedChannel.HasValue)
                {
                    <span># @SelectedChannel.Value.GetProperty("name").GetString()</span>
                }
            </div>

            <!-- Messages -->
            <div class="message-list" style="flex: 1;">
                @foreach (var message in Messages)
                {
                    var author = message.GetProperty("author");
                    var authorName = author.GetProperty("username").GetString();
                    var content = message.GetProperty("content").GetString();
                    var timestamp = message.GetProperty("timestamp").GetString();

                    <div class="message-item">
                        <div class="message-header">
                            <span class="message-author">@authorName</span>
                            <span class="message-time">
                                @(DateTime.Parse(timestamp ?? "").ToString("HH:mm"))
                            </span>
                        </div>
                        <div class="message-content">@content</div>
                    </div>
                }
            </div>

            <!-- Message input -->
            <MessageInput OnSendMessage="OnSendMessage" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<JsonElement> Guilds { get; set; } = new();

    [Parameter]
    public JsonElement? SelectedGuild { get; set; }

    [Parameter]
    public JsonElement? SelectedChannel { get; set; }

    [Parameter]
    public List<JsonElement> Messages { get; set; } = new();

    [Parameter]
    public EventCallback<JsonElement> OnGuildSelect { get; set; }

    [Parameter]
    public EventCallback<JsonElement> OnChannelSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnSendMessage { get; set; }
}
